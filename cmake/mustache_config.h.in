#ifndef MUSTACHE_CONFIG_H
#define MUSTACHE_CONFIG_H

#define MUSTACHE_PACKAGE_VERSION "@MUSTACHE_PACKAGE_VERSION@"
#define MUSTACHE_VERSION_MAJOR @MUSTACHE_VERSION_MAJOR@
#define MUSTACHE_VERSION_MINOR @MUSTACHE_VERSION_MINOR@
#define MUSTACHE_VERSION_PATCH @MUSTACHE_VERSION_PATCH@

#define MUSTACHE_CXX_STANDARD @MUSTACHE_CXX_STANDARD@
#define MUSTACHE_HAVE_CXX17 1
/* Deprecated compatibility alias: the required C++17 baseline includes C++11. */
#define MUSTACHE_HAVE_CXX11 1
#define MUSTACHE_HAVE_LIBJSON 1
#define MUSTACHE_HAVE_LIBYAML 1

#endif
