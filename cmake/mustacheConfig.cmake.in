@PACKAGE_INIT@

set(_mustache_supported_components shared static)
if(NOT mustache_FIND_COMPONENTS)
    set(mustache_FIND_COMPONENTS shared)
endif()

foreach(_mustache_component IN LISTS mustache_FIND_COMPONENTS)
    if(NOT _mustache_component IN_LIST _mustache_supported_components)
        set(mustache_${_mustache_component}_FOUND FALSE)
        set(mustache_NOT_FOUND_MESSAGE
            "Unsupported mustache component: ${_mustache_component}")
    endif()
endforeach()

if(shared IN_LIST mustache_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/mustacheSharedTargets.cmake")
    set(mustache_shared_FOUND TRUE)
endif()

if(static IN_LIST mustache_FIND_COMPONENTS)
    set(_mustache_static_dependencies_found TRUE)
    if(@MUSTACHE_HAVE_LIBYAML@)
        if(MSVC)
            find_package(yaml QUIET CONFIG)
            if(NOT TARGET yaml AND NOT TARGET yaml::yaml)
                set(_mustache_static_dependencies_found FALSE)
            endif()
        else()
            find_package(PkgConfig QUIET)
            if(PkgConfig_FOUND)
                pkg_check_modules(YAML QUIET IMPORTED_TARGET yaml-0.1)
            endif()
            if(NOT PkgConfig_FOUND OR NOT YAML_FOUND)
                set(_mustache_static_dependencies_found FALSE)
            endif()
        endif()
    endif()

    if(@MUSTACHE_HAVE_ARCHIVED_TEMPLATES@)
        if(@MUSTACHE_USE_SYSTEM_XXHASH@)
            find_package(xxHash 0.8 QUIET CONFIG)
            if(NOT TARGET xxHash::xxhash)
                set(_mustache_static_dependencies_found FALSE)
            endif()
        endif()
    endif()

    if(_mustache_static_dependencies_found)
        include("${CMAKE_CURRENT_LIST_DIR}/mustacheStaticTargets.cmake")
        set(mustache_static_FOUND TRUE)
    else()
        set(mustache_static_FOUND FALSE)
        if(mustache_FIND_REQUIRED_static)
            set(mustache_FOUND FALSE)
            set(mustache_NOT_FOUND_MESSAGE
                "The mustache static component's private dependencies are unavailable")
            return()
        endif()
    endif()
endif()

check_required_components(mustache)
