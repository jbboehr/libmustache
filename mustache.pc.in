prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: Mustache
Description: Library for mustache
URL: https://github.com/jbboehr/libmustache
Version: @VERSION@
Libs: -L${libdir} -lmustache
Requires.private: @MUSTACHE_PKGCONFIG_REQUIRES_PRIVATE@
Cflags: -I${includedir} @MUSTACHE_CXX_STANDARD_FLAG@ @MUSTACHE_CONSUMER_EXPORT_CPPFLAGS@
