function(mustache_configure_and_build_probe MUSTACHE_NAME
        MUSTACHE_CISTA_ROOT MUSTACHE_OUTPUT_EXECUTABLE_VARIABLE)
    set(MUSTACHE_BUILD_DIR
        "${MUSTACHE_TEST_BINARY_ROOT}/${MUSTACHE_NAME}-build")
    set(MUSTACHE_RUNTIME_DIR
        "${MUSTACHE_TEST_BINARY_ROOT}/${MUSTACHE_NAME}-bin")
    execute_process(
        COMMAND "${CMAKE_COMMAND}"
            -S "${MUSTACHE_TEST_SOURCE_DIR}"
            -B "${MUSTACHE_BUILD_DIR}"
            ${MUSTACHE_GENERATOR_ARGUMENTS}
            "-DCMAKE_CXX_COMPILER=${MUSTACHE_TEST_CXX_COMPILER}"
            ${MUSTACHE_FORWARDED_CMAKE_ARGUMENTS}
            "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY=${MUSTACHE_RUNTIME_DIR}"
            "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG=${MUSTACHE_RUNTIME_DIR}"
            "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE=${MUSTACHE_RUNTIME_DIR}"
            "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY_RELWITHDEBINFO=${MUSTACHE_RUNTIME_DIR}"
            "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY_MINSIZEREL=${MUSTACHE_RUNTIME_DIR}"
            -DMUSTACHE_BUILD_CLI=OFF
            -DMUSTACHE_ENABLE_TESTS=ON
            -DMUSTACHE_ENABLE_HARDENING=OFF
            -DMUSTACHE_ENABLE_JSON=OFF
            -DMUSTACHE_ENABLE_YAML=OFF
            -DMUSTACHE_ENABLE_ARCHIVED_TEMPLATES=ON
            -DMUSTACHE_USE_SYSTEM_CISTA=ON
            -DMUSTACHE_USE_SYSTEM_XXHASH=OFF
            -DMUSTACHE_WARNINGS_AS_ERRORS=ON
            -DMUSTACHE_TEST_CISTA_VERSION_MUTATION=ON
            "-Dcista_DIR=${MUSTACHE_CISTA_ROOT}/lib/cmake/cista"
        RESULT_VARIABLE MUSTACHE_CONFIGURE_RESULT
        OUTPUT_VARIABLE MUSTACHE_CONFIGURE_OUTPUT
        ERROR_VARIABLE MUSTACHE_CONFIGURE_ERROR)
    if(NOT MUSTACHE_CONFIGURE_RESULT EQUAL 0)
        message(FATAL_ERROR
            "Configuring the ${MUSTACHE_NAME} Cista mutation probe failed:\n${MUSTACHE_CONFIGURE_OUTPUT}${MUSTACHE_CONFIGURE_ERROR}")
    endif()
    file(STRINGS "${MUSTACHE_BUILD_DIR}/CMakeCache.txt"
        MUSTACHE_NESTED_CXX_FLAGS_LINE
        REGEX "^CMAKE_CXX_FLAGS:STRING=")
    if(NOT MUSTACHE_NESTED_CXX_FLAGS_LINE STREQUAL
            "CMAKE_CXX_FLAGS:STRING=${MUSTACHE_EFFECTIVE_TEST_CXX_FLAGS}")
        message(FATAL_ERROR
            "The ${MUSTACHE_NAME} Cista mutation probe did not inherit the parent compiler ABI flags")
    endif()

    execute_process(
        COMMAND "${CMAKE_COMMAND}" --build "${MUSTACHE_BUILD_DIR}"
            --target test_cista_version_mutation
            ${MUSTACHE_BUILD_CONFIG_ARGUMENTS}
        RESULT_VARIABLE MUSTACHE_BUILD_RESULT
        OUTPUT_VARIABLE MUSTACHE_BUILD_OUTPUT
        ERROR_VARIABLE MUSTACHE_BUILD_ERROR)
    if(NOT MUSTACHE_BUILD_RESULT EQUAL 0)
        message(FATAL_ERROR
            "Building the ${MUSTACHE_NAME} Cista mutation probe failed:\n${MUSTACHE_BUILD_OUTPUT}${MUSTACHE_BUILD_ERROR}")
    endif()

    set(${MUSTACHE_OUTPUT_EXECUTABLE_VARIABLE}
        "${MUSTACHE_RUNTIME_DIR}/test_cista_version_mutation${MUSTACHE_TEST_EXECUTABLE_SUFFIX}"
        PARENT_SCOPE)
endfunction()

function(mustache_expect_algorithm_drift_rejection MUSTACHE_CISTA_ROOT)
    set(MUSTACHE_BUILD_DIR
        "${MUSTACHE_TEST_BINARY_ROOT}/drift-build")
    execute_process(
        COMMAND "${CMAKE_COMMAND}"
            -S "${MUSTACHE_TEST_SOURCE_DIR}"
            -B "${MUSTACHE_BUILD_DIR}"
            ${MUSTACHE_GENERATOR_ARGUMENTS}
            "-DCMAKE_CXX_COMPILER=${MUSTACHE_TEST_CXX_COMPILER}"
            ${MUSTACHE_FORWARDED_CMAKE_ARGUMENTS}
            -DMUSTACHE_BUILD_CLI=OFF
            -DMUSTACHE_ENABLE_TESTS=OFF
            -DMUSTACHE_ENABLE_HARDENING=OFF
            -DMUSTACHE_ENABLE_JSON=OFF
            -DMUSTACHE_ENABLE_YAML=OFF
            -DMUSTACHE_ENABLE_ARCHIVED_TEMPLATES=ON
            -DMUSTACHE_USE_SYSTEM_CISTA=ON
            -DMUSTACHE_USE_SYSTEM_XXHASH=OFF
            -DMUSTACHE_WARNINGS_AS_ERRORS=ON
            "-Dcista_DIR=${MUSTACHE_CISTA_ROOT}/lib/cmake/cista"
        RESULT_VARIABLE MUSTACHE_CONFIGURE_RESULT
        OUTPUT_VARIABLE MUSTACHE_CONFIGURE_OUTPUT
        ERROR_VARIABLE MUSTACHE_CONFIGURE_ERROR)
    if(MUSTACHE_CONFIGURE_RESULT EQUAL 0)
        message(FATAL_ERROR
            "Cista recursive type-version algorithm drift was not rejected during configuration")
    endif()
    set(MUSTACHE_CONFIGURE_LOG
        "${MUSTACHE_CONFIGURE_OUTPUT}${MUSTACHE_CONFIGURE_ERROR}")
    string(FIND "${MUSTACHE_CONFIGURE_LOG}"
        "The selected Cista runtime type-version algorithm"
        MUSTACHE_EXPECTED_REJECTION_POSITION)
    if(MUSTACHE_EXPECTED_REJECTION_POSITION EQUAL -1)
        message(FATAL_ERROR
            "Cista recursive type-version algorithm drift failed at the wrong boundary:\n${MUSTACHE_CONFIGURE_LOG}")
    endif()
endfunction()

mustache_configure_and_build_probe(baseline
    "${MUSTACHE_BASELINE_CISTA_ROOT}" MUSTACHE_BASELINE_PROBE)
mustache_configure_and_build_probe(domain
