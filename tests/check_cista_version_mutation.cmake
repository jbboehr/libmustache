    MUSTACHE_BASELINE_CISTA_HEADER_CONTENTS)
set(MUSTACHE_CISTA_BASE_HASH
    "constexpr auto const BASE_HASH = 0ULL;")
set(MUSTACHE_DOMAIN_CISTA_BASE_HASH
    "constexpr auto const BASE_HASH = 0x9E3779B97F4A7C15ULL;")
string(REPLACE
    "${MUSTACHE_CISTA_BASE_HASH}"
    "${MUSTACHE_DOMAIN_CISTA_BASE_HASH}"
    MUSTACHE_DOMAIN_CISTA_HEADER_CONTENTS
    "${MUSTACHE_BASELINE_CISTA_HEADER_CONTENTS}")
if(MUSTACHE_DOMAIN_CISTA_HEADER_CONTENTS STREQUAL
        MUSTACHE_BASELINE_CISTA_HEADER_CONTENTS)
    message(FATAL_ERROR
        "The controlled Cista base-hash mutation did not match the vendored header")
endif()

set(MUSTACHE_CISTA_VECTOR_MARKER
    "h = hash_combine(h, hash(\"vector\"));")
set(MUSTACHE_DRIFT_CISTA_VECTOR_MARKER
    "h = hash_combine(h, hash(\"vector-algorithm-drift\"));")
string(REPLACE
    "${MUSTACHE_CISTA_VECTOR_MARKER}"
    "${MUSTACHE_DRIFT_CISTA_VECTOR_MARKER}"
    MUSTACHE_DRIFT_CISTA_HEADER_CONTENTS
    "${MUSTACHE_BASELINE_CISTA_HEADER_CONTENTS}")
if(MUSTACHE_DRIFT_CISTA_HEADER_CONTENTS STREQUAL
        MUSTACHE_BASELINE_CISTA_HEADER_CONTENTS)
    message(FATAL_ERROR
        "The controlled Cista recursive-algorithm mutation did not match the vendored header")
endif()

function(mustache_write_cista_package MUSTACHE_PACKAGE_ROOT
        MUSTACHE_HEADER_CONTENTS_VARIABLE)
    set(MUSTACHE_PACKAGE_INCLUDE_DIR
        "${MUSTACHE_PACKAGE_ROOT}/include")
    set(MUSTACHE_PACKAGE_CONFIG_DIR
        "${MUSTACHE_PACKAGE_ROOT}/lib/cmake/cista")
    file(MAKE_DIRECTORY
        "${MUSTACHE_PACKAGE_INCLUDE_DIR}/cista"
        "${MUSTACHE_PACKAGE_CONFIG_DIR}")
    file(WRITE "${MUSTACHE_PACKAGE_INCLUDE_DIR}/cista/serialization.h"
        "${${MUSTACHE_HEADER_CONTENTS_VARIABLE}}")
    file(WRITE "${MUSTACHE_PACKAGE_CONFIG_DIR}/cistaConfig.cmake" [=[
if(NOT TARGET cista::cista)
    add_library(cista::cista INTERFACE IMPORTED)
    get_filename_component(CISTA_TEST_PREFIX
        "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
    set_target_properties(cista::cista PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${CISTA_TEST_PREFIX}/include")
endif()
]=])
endfunction()

