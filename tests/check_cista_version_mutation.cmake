macro(mustache_forward_cache_variable MUSTACHE_PARENT_VARIABLE
        MUSTACHE_NESTED_VARIABLE)
    if(DEFINED ${MUSTACHE_PARENT_VARIABLE})
        string(REPLACE ";" "\\;" MUSTACHE_FORWARDED_VALUE
            "${${MUSTACHE_PARENT_VARIABLE}}")
        list(APPEND MUSTACHE_FORWARDED_CMAKE_ARGUMENTS
            "-D${MUSTACHE_NESTED_VARIABLE}=${MUSTACHE_FORWARDED_VALUE}")
    endif()
endmacro()
