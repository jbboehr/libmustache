function(mustache_run_probe MUSTACHE_DESCRIPTION MUSTACHE_EXECUTABLE)
    execute_process(
        COMMAND "${MUSTACHE_EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE MUSTACHE_PROBE_RESULT
        OUTPUT_VARIABLE MUSTACHE_PROBE_OUTPUT
        ERROR_VARIABLE MUSTACHE_PROBE_ERROR)
    if(NOT MUSTACHE_PROBE_RESULT EQUAL 0)
        message(FATAL_ERROR
            "${MUSTACHE_DESCRIPTION} failed:\n${MUSTACHE_PROBE_OUTPUT}${MUSTACHE_PROBE_ERROR}")
    endif()
endfunction()

mustache_run_probe("Producing the native baseline archive"
